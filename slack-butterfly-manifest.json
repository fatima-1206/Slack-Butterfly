{
    "display_information": {
        "name": "Slack Butterfly"
    },
    "features": {
        "bot_user": {
            "display_name": "Slack Butterfly",
            "always_online": false
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "chat:write",
                "im:history",
                "im:read",
                "im:write",
                "users:read"
            ]
        },
        "redirect_urls": [
            "https://slack-butterfly.vercel.app/api/slack/oauth/callback"
        ],
        "pkce_enabled": false
    },
    "settings": {
        "interactivity": {
            "is_enabled": true,
            "request_url": "https://slack-butterfly.vercel.app/api/slack/events"
        },
        "event_subscriptions": {
            "request_url": "https://slack-butterfly.vercel.app/api/slack/events",
            "bot_events": [
                "message.im"
            ]
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "token_rotation_enabled": false,
        "is_mcp_enabled": false
    }
}